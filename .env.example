# Core application mode
VISARA_ENVIRONMENT=development
VISARA_DEBUG=true
VISARA_API_PREFIX=/api/v1
VISARA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required runtime configuration
VISARA_DATABASE_URL=postgresql+asyncpg://visara:visara@localhost:5432/visara
VISARA_SECRET_KEY=change-me-for-local-development
VISARA_STORAGE_TYPE=local
VISARA_STORAGE_PATH=.data/storage
VISARA_STORAGE_BUCKET=visara
VISARA_GPU_ENABLED=false

# JWT session policy
VISARA_JWT_ALGORITHM=HS256
VISARA_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional S3 / MinIO configuration when VISARA_STORAGE_TYPE=s3
VISARA_STORAGE_ENDPOINT_URL=http://localhost:9000
VISARA_STORAGE_ACCESS_KEY=minioadmin
VISARA_STORAGE_SECRET_KEY=minioadmin123
VISARA_STORAGE_REGION=us-east-1
VISARA_STORAGE_SECURE=false

# Model runtime
VISARA_MODEL_VERSION=visara-v3
VISARA_MODEL_STATUS=operational
VISARA_MODEL_FACTORY_PATH=app.services.inference.model.model:DualDRModel
VISARA_MODEL_CHECKPOINT_PATH=/nfs_home/users/vsshekhawat/projects/dr-mvp-v3/checkpoints/phase2/best_qwk.pt
VISARA_CASE_SUBMISSION_RATE_LIMIT=10
VISARA_CASE_SUBMISSION_RATE_WINDOW_SECONDS=600

# Seeded research users
VISARA_DEMO_DOCTOR_EMAIL=saumya.agarwal@bits-pilani.ac.in
VISARA_DEMO_DOCTOR_PASSWORD=VisaraDemo123!
VISARA_DEMO_DOCTOR_NAME="Dr. Saumya Agarwal"
VISARA_DEMO_TECHNICIAN_EMAIL=screening.tech@bits-pilani.ac.in
VISARA_DEMO_TECHNICIAN_PASSWORD=VisaraTech123!
VISARA_DEMO_TECHNICIAN_NAME="Screening Technician"
VISARA_DEMO_ADMIN_EMAIL=admin@bits-pilani.ac.in
VISARA_DEMO_ADMIN_PASSWORD=VisaraAdmin123!
VISARA_DEMO_ADMIN_NAME="Research Administrator"
